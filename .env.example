# Copy to ~/.config/agent-office.env (chmod 600) and fill in.
NODE_ENV=production
PORT=18789
HOST=0.0.0.0

# Portal login
PORTAL_EMAIL=you@example.com
# The login password, as an scrypt hash: run `agent-office hash-password` (or node scripts/hash-password.js) and paste
# the scrypt:… line here. (A plaintext PORTAL_PASSWORD still works this release, with a warning; don't use it.)
PORTAL_PASSWORD_HASH=
# Display name shown in the UI (not a secret); default: the e-mail's local part
# PORTAL_DISPLAY_NAME=Owner
# Random string used to sign session cookies: `openssl rand -hex 24`
PORTAL_SECRET=

# OpenClaw gateway (gateway.auth.token in ~/.openclaw/openclaw.json)
OC_GATEWAY_TOKEN=
# Optional overrides. Every OpenClaw path derives from ONE runtime home (OC_HOME, default: this process's HOME):
#   identity <home>/.openclaw/identity/device.json, else the state DB <home>/.openclaw/state/openclaw.sqlite;
#   config <home>/.openclaw/openclaw.json; bin: `openclaw` on PATH, else <home>/.npm-global/bin/openclaw.
# Without an identity or token the server still starts; the gateway shows as "not configured".
# OC_GATEWAY_URL=ws://127.0.0.1:18793
# OC_HOME=/path/to/home             (also the HOME the openclaw CLI runs with)
# OC_IDENTITY=/path/to/device.json
# OC_STATE_DB=/path/to/openclaw.sqlite
# OC_CONFIG=/path/to/openclaw.json
# OC_BIN=/path/to/openclaw
# Staging only: refuse OpenClaw and runtime mutations (CLI writes, gateway restart, agent turns).
# Store writes (projects, layout, prefs, mute) stay allowed.
# PORTAL_READONLY=1
# Also refuse those store writes. Set both to block every application write.
# PORTAL_READONLY_STORE=1

# Instance: production | staging | dev | test. Default: staging when PORTAL_READONLY=1,
# production when NODE_ENV=production, else dev. A data dir belongs to one instance for life.
# AO_ENV=production
# Store directory (not a secret). Default: $XDG_DATA_HOME or ~/.local/share, + agent-office[-staging|-dev].
# Staging/dev refuse production's directory.
# AO_DATA_DIR=/srv/agent-office/data

# Projets: code-host discovery and repo refresh are OFF until configured (no default owner or workspace root).
# AO_PROJECTS_OWNERS=your-github-user,your-org
# AO_PROJECTS_ROOT=/path/to/your/workspace
# AO_PROJECTS_DISCOVERY=0        (forces it off, e.g. tests)
