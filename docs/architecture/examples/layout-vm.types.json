{
  "$comment": "Shape sidecar for layout-vm.json (api.md §3.10). The manifest's shape is manifest.schema.json's (office-dev).",
  "opaque": [
    "$.manifest"
  ],
  "nullable": [
    "$.theme.nextChangeAt",
    "$.agentsSeen[].automaticLook.variant"
  ],
  "types": {
    "$.layout.updatedBy.avatarUrl": "string",
    "$.layout.updatedBy.state": "string",
    "$.layout.data.theme.season": "string",
    "$.theme.season": "string",
    "$.default.data.theme.season": "string",
    "$.revisions[].updatedBy.avatarUrl": "string",
    "$.revisions[].updatedBy.state": "string",
    "$.layout.data.agents[].name": "string",
    "$.layout.data.agents[].role": "string",
    "$.default.data.agents[].name": "string",
    "$.default.data.agents[].role": "string",
    "$.allowNoDesk": "boolean"
  },
  "variants": {
    "$.layout.updatedBy": [
      {
        "kind": "system",
        "name": "Système"
      }
    ]
  },
  "additional": {
    "$.agentsSeen[].automaticLook": {
      "character": "fen",
      "variant": "moss",
      "accessories": [
        "scarf"
      ]
    }
  },
  "optional": [
    "$.layout.data.agents[].appearance",
    "$.default.data.agents[].appearance",
    "$.allowNoDesk"
  ]
}
