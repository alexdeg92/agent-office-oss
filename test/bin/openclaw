#!/usr/bin/env node
'use strict';
/*
 * Fake `openclaw` CLI for tests. Never touches OpenClaw.
 *   FAKE_OC_SCENARIO  scenario name (<FAKE_OC_FIXTURES>/scenarios/<name>.json)
 *   FAKE_OC_FIXTURES  fixtures root (default test/fixtures; local captures: test/fixtures/local)
 *   FAKE_OC_LOG       optional JSONL file; every invocation's argv is appended
 *   FAKE_OC_FAIL      optional comma list of subcommands that fail (e.g. 'cron run,config set')
 * Read commands answer from the scenario's CLI fixtures; write commands only log and print a fixed ok.
 */
const fs = require('fs');
const path = require('path');
const FIX = process.env.FAKE_OC_FIXTURES || path.resolve(__dirname, '..', 'fixtures');
const argv = process.argv.slice(2);
if (process.env.FAKE_OC_LOG) fs.appendFileSync(process.env.FAKE_OC_LOG, JSON.stringify({ argv }) + '\n');

const sc = process.env.FAKE_OC_SCENARIO ? JSON.parse(fs.readFileSync(path.join(FIX, 'scenarios', process.env.FAKE_OC_SCENARIO + '.json'), 'utf8')) : { cli: {} };
const cli = sc.cli || {};
const out = (s) => process.stdout.write(String(s).split('{{FIXTURES_DIR}}').join(FIX));
const fromFixture = (rel) => {
  const b = JSON.parse(fs.readFileSync(path.join(FIX, rel), 'utf8')).body;
  if (b.kind === 'text') { out(b.value); return b.exitCode || 0; }
  if (b.kind === 'json') { out(JSON.stringify(b.value, null, 2) + '\n'); return 0; }
  process.stderr.write(b.message || 'error\n'); return 1;
};
const flag = (name) => { const i = argv.indexOf(name); return i >= 0 ? argv[i + 1] : undefined; };
const sub = argv.slice(0, 2).join(' ');
const fails = (process.env.FAKE_OC_FAIL || '').split(',').map((s) => s.trim()).filter(Boolean);
if (fails.includes(sub) || fails.includes(argv[0])) { process.stderr.write('simulated failure: ' + sub + '\n'); process.exit(1); }

function main() {
  if (sub === 'gateway call' && argv[2] === 'sessions.patch') {
    const params = JSON.parse(argv.find(a => a.startsWith('--params=')).slice(9));
    out(JSON.stringify({ ok: true, key: params.key, entry: { sendPolicy: params.sendPolicy } })); return 0;
  }
  if (argv[0] === '--version') { out('OpenClaw ' + (sc.openclawVersion || '0.0.0') + '\n'); return 0; }
  if (sub === 'skills list' || sub === 'skills info') {
    // Real behaviour with several agents configured: per-agent commands need --agent, else {ok:false}.
    if (!flag('--agent')) { out('{"ok":false,"error":"several agents are configured; pass --agent"}\n'); return 1; }
    if (sub === 'skills list') return cli['skills.list'] ? fromFixture(cli['skills.list']) : (out('{"skills":[]}\n'), 0);
    const name = argv[2]; const f = (cli['skills.info'] || {})[name];
    if (!f) { out('{"ok":false,"error":"skill not found"}\n'); return 1; }
    return fromFixture(f);
  }
  // architect-56: the agents (FAKE_OC_AGENTS: a JSON array; default: main in FAKE_OC_WORKSPACE) and the exec policy
  if (sub === 'agents list') {
    out(process.env.FAKE_OC_AGENTS || JSON.stringify([{ id: 'main', name: 'Main', workspace: process.env.FAKE_OC_WORKSPACE || '/nonexistent/workspace', isDefault: true }]));
    return 0;
  }
  if (sub === 'approvals get') {
    const mode = process.env.FAKE_OC_EXEC_MODE || 'full';
    out('Approvals\n' + JSON.stringify({ effectivePolicy: { scopes: [{ scopeLabel: 'tools.exec', configPath: 'tools.exec', agentId: 'main', mode: { effective: mode } }] } }));
    return 0;
  }
  if (argv[0] === 'agent') {
    // FAKE_OC_AGENT_DELAY_MS holds the turn (deterministic "pending" tests)
    if (process.env.FAKE_OC_AGENT_DELAY_MS) { const until = Date.now() + Number(process.env.FAKE_OC_AGENT_DELAY_MS); while (Date.now() < until) { /* hold */ } }
    if (cli['agent.turn']) return fromFixture(cli['agent.turn']);
    out(JSON.stringify({ result: { payloads: [{ text: 'Réponse factice.' }], meta: { durationMs: 1000, agentMeta: { model: 'fake-model', provider: 'fake', usage: { total: 100 } } } } }) + '\n');
    return 0;
  }
  const writes = ['cron add', 'cron edit', 'cron enable', 'cron disable', 'cron run', 'cron rm', 'config set'];
  // with --json the real CLI answers a JSON acknowledgement (cron add: the new job's id)
  if (writes.includes(sub)) { out(sub === 'cron add' && argv.includes('--json') ? '{"ok":true,"id":"ffffffff-0c99-4000-8000-000000000099"}\n' : sub === 'cron rm' ? '{"ok":true}\n' : 'ok\n'); return 0; }
  process.stderr.write('fake openclaw: unsupported command: ' + argv.join(' ') + '\n');
  return 2;
}
process.exit(main());
